{
  "manifest_version": 3,
  "name": "FB Marketplace Smart Search",
  "version": "0.1.0",
  "description": "Keep Facebook Marketplace results only when every search word appears in the title or description.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "FB Marketplace Smart Search",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "scripting", "webNavigation"],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://web.facebook.com/*",
    "https://facebook.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*marketplace*",
        "https://web.facebook.com/*marketplace*",
        "https://facebook.com/*marketplace*"
      ],
      "js": ["content/main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.facebook.com/*marketplace*",
        "https://web.facebook.com/*marketplace*",
        "https://facebook.com/*marketplace*"
      ],
      "js": ["content/isolated.js"],
      "css": ["content/overlay.css"],
      "run_at": "document_idle"
    }
  ]
}
